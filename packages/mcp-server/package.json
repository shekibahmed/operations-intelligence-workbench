{
  "name": "@oiw/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-mostly stdio MCP server over Scenario Packs, adversarial fixtures and evaluation.",
  "bin": {
    "oiw-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@oiw/contracts": "workspace:*",
    "@oiw/scenario-sdk": "workspace:*",
    "zod": "^4.1.5"
  }
}
