{
  "name": "@oiw/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Operations Intelligence Workbench Scenario Packs, adversarial synthetic fixtures and an evidence casebook.",
  "type": "module",
  "license": "MIT",
  "mcpName": "io.github.shekibahmed/oiw-mcp",
  "author": "Shekib Ahmed",
  "homepage": "https://github.com/shekibahmed/operations-intelligence-workbench/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/shekibahmed/operations-intelligence-workbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shekibahmed/operations-intelligence-workbench.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scenario-packs",
    "evaluation",
    "fixtures"
  ],
  "bin": {
    "oiw-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scenario-packs",
    "README.md",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "pnpm build",
    "prepack": "node scripts/stage-packs.mjs && node scripts/prepare-pack.mjs",
    "postpack": "node scripts/restore-pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oiw/scenario-sdk": "workspace:*",
    "esbuild": "0.28.2"
  }
}
