# Copy to `.env` and adjust before running the full-container demo
# (`docker compose --profile full-demo up web`). Compose reads this file
# automatically; nothing here is committed.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=at-least-32-bytes-of-entropy
SESSION_SECRET=at-least-32-bytes-of-entropy

# Optional tuning for the web container / any host-run server:
# DATABASE_POOL_MAX=10
# OIW_RATE_LIMIT_STORE=postgres
# NEXT_PUBLIC_SITE_URL=https://your-demo-host
