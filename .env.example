# Copy to `.env`. Compose reads this file automatically; nothing here is
# committed, and the values below are placeholders, not secrets.
#
# `docker compose up -d` (postgres only) needs NO `.env` at all. These
# variables matter only for the full-container demo:
#   docker compose --profile full-demo up --build web
#
# The Compose postgres service and the web container share these two values.
# They default to postgres/postgres; if you change them, delete the old
# `oiw-postgres-data` volume (or use matching credentials) and update the
# DATABASE_URL you use for `pnpm db:migrate` on the host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# REQUIRED for the web container, at least 32 bytes, no default on purpose
# (the container refuses to start without it). Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-bytes-of-entropy

# Optional tuning for the web container / any host-run server:
# DATABASE_POOL_MAX=10
# OIW_RATE_LIMIT_STORE=postgres
# NEXT_PUBLIC_SITE_URL=https://your-demo-host

# Production-only (see docs/DEPLOYMENT.md §4) — never commit real values.
# On Render these are provisioned by render.yaml (docs/DEPLOYMENT.md §9):
# OIW_RATE_LIMIT_IP_SALT=at-least-32-bytes-of-entropy
# OIW_TRUSTED_PROXY_HEADER=x-forwarded-for
# OIW_ASSESSMENT_SINK=postgres

# Hosted demo (GitHub side, not read from .env): repository secrets
# DATABASE_URL and RENDER_DEPLOY_HOOK_URL, repository variable
# RENDER_APP_URL. See docs/DEPLOYMENT.md §9.
