[
  {
    "id": "repeated-deviation-escalation",
    "version": "1.0.0",
    "description": "Flag a repeated-deviation signal when a confirmed QC deviation explicitly reports consistency with the preceding batch finding, indicating recurrence rather than a one-off.",
    "when": {
      "all": [
        { "fact": { "kind": "event-field", "field": "eventType" }, "operator": "equals", "value": "qc-deviation-confirmed" },
        { "fact": { "kind": "observation", "schemaKey": "reported-cause", "field": "value" }, "operator": "exists" }
      ]
    },
    "then": [
      { "type": "create-signal", "definitionId": "repeated-deviation", "parameters": { "severity": "high" } }
    ]
  },
  {
    "id": "supplier-pattern-escalation",
    "version": "1.0.0",
    "description": "Elevate to a supplier-linked-pattern signal when a confirmed QC deviation explicitly links its finding to a preceding batch and identifies the suspected supplier lot.",
    "when": {
      "all": [
        { "fact": { "kind": "event-field", "field": "eventType" }, "operator": "equals", "value": "qc-deviation-confirmed" },
        { "fact": { "kind": "observation", "schemaKey": "reported-cause", "field": "value" }, "operator": "exists" },
        { "fact": { "kind": "observation", "schemaKey": "supplier-lot-identifier", "field": "value" }, "operator": "exists" }
      ]
    },
    "then": [
      { "type": "create-signal", "definitionId": "supplier-linked-pattern", "parameters": { "severity": "high" } }
    ]
  },
  {
    "id": "escalating-backlog-escalation",
    "version": "1.0.0",
    "description": "Flag an escalating-backlog signal when a held-output aging event reaches an already-open related exception case, indicating undispositioned output is accumulating rather than clearing.",
    "when": {
      "all": [
        { "fact": { "kind": "event-field", "field": "eventType" }, "operator": "equals", "value": "held-output-aging-flagged" },
        { "fact": { "kind": "aggregate", "aggregate": "open-case-count" }, "operator": "greater-than-or-equal", "value": 1 }
      ]
    },
    "then": [
      { "type": "create-signal", "definitionId": "escalating-backlog", "parameters": { "severity": "medium" } }
    ]
  },
  {
    "id": "root-cause-investigation-triggered",
    "version": "1.0.0",
    "description": "Open a root-cause-investigation action item whenever a supervisor formally requests one.",
    "when": {
      "fact": { "kind": "event-field", "field": "eventType" },
      "operator": "equals",
      "value": "root-cause-investigation-requested"
    },
    "then": [
      { "type": "create-signal", "definitionId": "root-cause-hypothesis", "parameters": { "severity": "medium" } },
      { "type": "create-action", "definitionId": "root-cause-investigation", "parameters": {} }
    ]
  }
]
