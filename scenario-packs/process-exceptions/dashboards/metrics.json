[
  {
    "id": "open-exceptions",
    "name": "Open Exceptions",
    "description": "Count of exception cases currently open (not yet closed).",
    "classification": "calculated",
    "aggregation": "count-where",
    "parameters": {
      "recordType": "cases",
      "filters": [
        { "field": "caseType", "operator": "equals", "value": "exception-case" },
        { "field": "status", "operator": "equals", "value": "open" }
      ]
    },
    "format": "number"
  },
  {
    "id": "critical-signals-open",
    "name": "Critical Signals",
    "description": "Count of signals at critical or high severity that have not yet been reviewed away.",
    "classification": "calculated",
    "aggregation": "count-where",
    "parameters": {
      "recordType": "signals",
      "filters": [{ "field": "severity", "operator": "in", "values": ["high", "critical"] }]
    },
    "format": "number"
  },
  {
    "id": "pending-decisions",
    "name": "Pending Decisions",
    "description": "Count of Decisions currently awaiting supervisor/QC approval.",
    "classification": "calculated",
    "aggregation": "count-where",
    "parameters": {
      "recordType": "decisions",
      "filters": [{ "field": "status", "operator": "equals", "value": "awaiting-approval" }]
    },
    "format": "number"
  },
  {
    "id": "exceptions-by-severity",
    "name": "Exceptions by Severity",
    "description": "Count of exception cases grouped by severity.",
    "classification": "calculated",
    "aggregation": "count-by-field",
    "parameters": {
      "recordType": "cases",
      "field": "severity",
      "filters": [{ "field": "caseType", "operator": "equals", "value": "exception-case" }]
    },
    "format": "number"
  },
  {
    "id": "exceptions-by-process-stage",
    "name": "Exceptions by Process Stage",
    "description": "Count of exception cases grouped by the process-stage observation of their triggering event.",
    "classification": "calculated",
    "aggregation": "count-by-field",
    "parameters": {
      "recordType": "cases",
      "field": "status",
      "filters": [{ "field": "caseType", "operator": "equals", "value": "exception-case" }]
    },
    "format": "number"
  },
  {
    "id": "weekly-deviation-trend",
    "name": "Weekly Deviation Trend",
    "description": "Count of confirmed QC deviation events per week, used to visualise the escalating pattern over time.",
    "classification": "calculated",
    "aggregation": "trend-over-time",
    "parameters": {
      "recordType": "events",
      "timestampField": "occurredAt",
      "bucket": "week",
      "filters": [{ "field": "eventType", "operator": "equals", "value": "qc-deviation-confirmed" }]
    },
    "format": "number"
  },
  {
    "id": "cases-at-sla-risk",
    "name": "Cases at SLA Risk",
    "description": "Exception cases at risk of breaching their implicit review/disposition SLA given time already elapsed without a decision.",
    "classification": "calculated",
    "aggregation": "sla-derived",
    "parameters": {
      "recordType": "cases",
      "atRiskWithinHours": 24,
      "filters": [{ "field": "caseType", "operator": "equals", "value": "exception-case" }]
    },
    "format": "number"
  },
  {
    "id": "repeated-deviation-rate",
    "name": "Repeated Deviation Rate",
    "description": "Share of confirmed deviations that are part of a repeated/pattern signal rather than an isolated one-off.",
    "classification": "calculated",
    "aggregation": "count-by-field",
    "parameters": {
      "recordType": "signals",
      "field": "severity",
      "filters": [{ "field": "signalType", "operator": "equals", "value": "repeated-deviation" }]
    },
    "format": "percentage"
  },
  {
    "id": "time-to-disposition",
    "name": "Time to Disposition",
    "description": "Average elapsed time from a confirmed QC deviation to an approved disposition decision.",
    "classification": "calculated",
    "aggregation": "sla-derived",
    "parameters": {
      "recordType": "cases",
      "atRiskWithinHours": 24,
      "filters": [{ "field": "caseType", "operator": "equals", "value": "exception-case" }]
    },
    "format": "duration"
  },
  {
    "id": "output-awaiting-decision",
    "name": "Output Awaiting Decision",
    "description": "Count of held batches whose disposition decision has not yet been approved.",
    "classification": "calculated",
    "aggregation": "count-where",
    "parameters": {
      "recordType": "cases",
      "filters": [
        { "field": "caseType", "operator": "equals", "value": "exception-case" },
        { "field": "status", "operator": "equals", "value": "awaiting-disposition-approval" }
      ]
    },
    "format": "number"
  },
  {
    "id": "incomplete-investigations",
    "name": "Incomplete Investigations",
    "description": "Count of exception cases that carry at least one insufficient-evidence observation still blocking a confident finding.",
    "classification": "calculated",
    "aggregation": "count-where",
    "parameters": {
      "recordType": "cases",
      "filters": [
        { "field": "caseType", "operator": "equals", "value": "exception-case" },
        { "field": "status", "operator": "in", "values": ["open", "investigating"] }
      ]
    },
    "format": "number"
  },
  {
    "id": "recent-case-activity",
    "name": "Recent Case Activity",
    "description": "A short feed of the most recent exception-case events and signals, for the activity-feed widget.",
    "classification": "calculated",
    "aggregation": "trend-over-time",
    "parameters": {
      "recordType": "events",
      "timestampField": "occurredAt",
      "bucket": "day"
    },
    "format": "text"
  },
  {
    "id": "supplier-lot-exposure-outlook",
    "name": "Supplier Lot Exposure Outlook",
    "description": "Illustrative, non-authoritative narrative summarising exposure if the pending hold-affected-output decision remains unresolved. Always hypothetical; never presented as a measured value.",
    "classification": "hypothetical",
    "aggregation": "count",
    "parameters": {
      "recordType": "cases",
      "illustrative": {
        "summary": "Illustrative supplier-lot exposure; no operational rows are evaluated.",
        "assumptions": {
          "caseType": "exception-case",
          "observationSchemaKey": "supplier-lot-identifier"
        }
      }
    },
    "format": "text"
  }
]
