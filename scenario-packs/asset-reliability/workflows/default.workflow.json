{
  "id": "default",
  "version": "1.0.0",
  "initialState": "open",
  "states": [
    { "id": "open", "label": "Open", "terminal": false },
    { "id": "in-review", "label": "In Review", "terminal": false },
    { "id": "awaiting-approval", "label": "Awaiting Approval", "terminal": false },
    { "id": "resolved", "label": "Resolved", "terminal": false },
    { "id": "closed", "label": "Closed", "terminal": true }
  ],
  "transitions": [
    { "id": "start-review", "from": "open", "to": "in-review" },
    { "id": "propose-removal-decision", "from": "in-review", "to": "awaiting-approval" },
    { "id": "return-to-review", "from": "awaiting-approval", "to": "in-review" },
    { "id": "mark-resolved", "from": "in-review", "to": "resolved" },
    { "id": "close-resolved-case", "from": "resolved", "to": "closed" },
    { "id": "approve-and-close", "from": "awaiting-approval", "to": "closed", "requiresApprovalPolicyId": "asset-removal-approval" }
  ],
  "closureRequirements": [
    {
      "id": "inspection-completed",
      "type": "action-completed",
      "definitionId": "completion-inspection",
      "description": "A completed inspection action is required before this case can close."
    },
    {
      "id": "decision-resolved",
      "type": "decision-approved",
      "definitionId": "remove-from-service",
      "description": "Any proposed remove-from-service decision on this case's asset must be approved, rejected, or otherwise resolved before the case can close."
    }
  ]
}
